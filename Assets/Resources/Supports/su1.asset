  effectDescriptions:
  - level: 0
    description: Restores <b>3 HP</b> to one random unit
  - level: 1
    description: Restores <b>6 HP</b> to one random unit
  - level: 2
    description: Restores <b>2 HP</b> to all units
  - level: 3
    description: Restores <b>5 HP</b> to all units
  - level: 4
    description: Restores <b>10 HP</b> to all units
